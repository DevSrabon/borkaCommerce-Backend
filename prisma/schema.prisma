datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum product_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum variant_status {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum discount_type {
  PERCENTAGE
  FIXED_AMOUNT
}

enum offer_type {
  FLASH_SALE
  EID_SALE
  BLACK_FRIDAY
  RAMADAN_OFFER
  GENERIC
}

enum offer_status {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum order_status {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum payment_status {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum payment_method {
  STRIPE
  CASH_ON_DELIVERY
}

enum refund_status {
  PENDING
  SUCCEEDED
  FAILED
}

enum review_status {
  PENDING
  APPROVED
  REJECTED
}

enum inventory_transaction_type {
  PURCHASE
  SALE
  RETURN
  MANUAL_ADJUSTMENT
  TRANSFER
}

// 1. Categories (Recursive Tree)
model categories {
  id          String    @id @default(uuid())
  parent_id   String?
  parent      categories?  @relation("categories_to_categories", fields: [parent_id], references: [id])
  children    categories[] @relation("categories_to_categories")
  name        String
  slug        String    @unique
  description String?
  image       String?
  image_alt_text String?
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  show_in_navbar   Boolean   @default(true)
  show_on_homepage Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  product_categories product_categories[]
  offer_categories   offer_categories[]
  related_products   product_related_categories[]
}

// 2. Products
model products {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  description       String
  short_description String?
  sku_prefix        String?
  video_url         String?
  seo_title         String?
  seo_description   String?
  seo_keywords      String?
  tags              String?
  status            product_status    @default(DRAFT)
  is_featured       Boolean           @default(false)
  is_cod_allowed    Boolean           @default(true)
  published_at      DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  deleted_at        DateTime?

  product_categories product_categories[]
  related_categories product_related_categories[]
  images             product_images[]
  variants           product_variants[]
  reviews            reviews[]
  wishlists          wishlists[]
}

// 3. Product Categories (Many-to-Many Join Table)
model product_categories {
  product_id  String
  category_id String
  product     products  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  category    categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([product_id, category_id])
}

// 4. Product Images
model product_images {
  id           String   @id @default(uuid())
  product_id   String
  product      products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  image_url    String
  alt_text     String?
  sort_order   Int      @default(0)
  is_thumbnail Boolean  @default(false)
}

// 5. Variant Attributes (e.g., Color, Size, Fabric)
model attributes {
  id     String             @id @default(uuid())
  name   String             @unique
  values attribute_values[]
}

model attribute_values {
  id           String                     @id @default(uuid())
  attribute_id String
  attribute    attributes                 @relation(fields: [attribute_id], references: [id], onDelete: Cascade)
  value        String
  variants     variant_attribute_values[]

  @@unique([attribute_id, value])
}

// 6. Product Variants
model product_variants {
  id            String                     @id @default(uuid())
  product_id    String
  product       products                   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sku           String                     @unique
  barcode       String?                    @unique
  weight        Float? // in grams/kgs
  price         Decimal                    @db.Decimal(10, 2)
  compare_price Decimal?                   @db.Decimal(10, 2)
  cost_price    Decimal?                   @db.Decimal(10, 2)
  status        variant_status             @default(ACTIVE)
  created_at    DateTime                   @default(now())
  updated_at    DateTime                   @updatedAt

  attributes    variant_attribute_values[]
  images        variant_images[]
  inventories   inventory[]
  offers        offer_products[]
  cart_items    cart_items[]
  order_items   order_items[]
  transactions  inventory_transactions[]
}

// 7. Variant Attribute Mapping (Many-to-Many Join Table)
model variant_attribute_values {
  variant_id         String
  attribute_value_id String
  variant            product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  attribute_value    attribute_values @relation(fields: [attribute_value_id], references: [id], onDelete: Cascade)

  @@id([variant_id, attribute_value_id])
}

// 8. Variant Images
model variant_images {
  id         String           @id @default(uuid())
  variant_id String
  variant    product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  image      String
  alt_text   String?
  sort_order Int              @default(0)
}

// 9. Warehouses
model warehouses {
  id           String                 @id @default(uuid())
  name         String
  location     String
  inventories  inventory[]
  transactions inventory_transactions[]
}

// 10. Inventory
model inventory {
  id                 String           @id @default(uuid())
  variant_id         String
  variant            product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  warehouse_id       String
  warehouse          warehouses       @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  quantity           Int              @default(0)
  reserved_quantity  Int              @default(0)
  available_quantity Int              @default(0)
  updated_at         DateTime         @updatedAt

  @@unique([variant_id, warehouse_id])
}

// 11. Offers
model offers {
  id             String           @id @default(uuid())
  name           String
  type           offer_type       @default(GENERIC)
  priority       Int              @default(0) // Higher number = higher priority
  discount_type  discount_type
  discount_value Decimal          @db.Decimal(10, 2)
  start_date     DateTime
  end_date       DateTime
  status         offer_status     @default(ACTIVE)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  products       offer_products[]
  categories     offer_categories[]
}

// 12. Offer Products
model offer_products {
  offer_id   String
  variant_id String
  offer      offers           @relation(fields: [offer_id], references: [id], onDelete: Cascade)
  variant    product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@id([offer_id, variant_id])
}

// 13. Coupons
model coupons {
  id                 String        @id @default(uuid())
  code               String        @unique
  type               String        @default("discount")
  discount_type      discount_type
  discount_value     Decimal       @db.Decimal(10, 2)
  minimum_amount     Decimal?      @db.Decimal(10, 2)
  maximum_discount   Decimal?      @db.Decimal(10, 2)
  usage_limit        Int?
  usage_per_customer Int           @default(1)
  start_date         DateTime
  end_date           DateTime
  status             Boolean       @default(true)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  orders             orders[]
}

// 14. Customers & Better-Auth System Models
model customers {
  id             String             @id @default(uuid())
  first_name     String
  last_name      String
  email          String             @unique
  phone          String?
  password       String?
  email_verified Boolean            @default(false)
  avatar_url     String?
  otp_code       String?
  otp_expires_at DateTime?
  role           String             @default("CUSTOMER")
  is_blocked     Boolean            @default(false)
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  addresses      customer_addresses[]
  carts          carts[]
  orders         orders[]
  reviews        reviews[]
  wishlists      wishlists[]
  sessions       sessions[]
  accounts       accounts[]
  chat_sessions  chat_sessions[]
}

// Better-Auth Session
model sessions {
  id           String   @id @default(uuid())
  expires_at   DateTime
  token        String   @unique
  created_at   DateTime
  updated_at   DateTime
  ip_address   String?
  user_agent   String?
  customer_id  String
  customer     customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
}

// Better-Auth Account
model accounts {
  id                       String    @id @default(uuid())
  account_id               String
  provider_id              String
  customer_id              String
  customer                 customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  access_token             String?
  refresh_token            String?
  id_token                 String?
  access_token_expires_at  DateTime?
  refresh_token_expires_at DateTime?
  scope                    String?
  password                 String?
  created_at               DateTime
  updated_at               DateTime
}

// 15. Customer Addresses
model customer_addresses {
  id          String    @id @default(uuid())
  customer_id String
  customer    customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  country     String
  city        String
  area        String
  street      String
  building    String?
  postal_code String?
  is_default  Boolean   @default(false)
}

// 16. Cart
model carts {
  id          String      @id @default(uuid())
  customer_id String
  customer    customers   @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  items       cart_items[]
}

model cart_items {
  id         String           @id @default(uuid())
  cart_id    String
  cart       carts            @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  variant_id String
  variant    product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  quantity   Int              @default(1)

  @@unique([cart_id, variant_id])
}

// 17. Orders
model orders {
  id             String         @id @default(uuid())
  order_number   String         @unique
  customer_id    String
  customer       customers      @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  status         order_status   @default(PENDING)
  subtotal       Decimal        @db.Decimal(10, 2)
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  shipping       Decimal        @db.Decimal(10, 2)
  tax            Decimal        @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  currency       String         @default("AED")
  payment_status payment_status @default(PENDING)
  payment_method payment_method @default(STRIPE)
  coupon_id      String?
  coupon         coupons?       @relation(fields: [coupon_id], references: [id])
  delivery_partner String?
  tracking_number  String?
  tracking_url     String?
  delivery_notes   String?
  shipping_country     String?
  shipping_city        String?
  shipping_area        String?
  shipping_street      String?
  shipping_building    String?
  shipping_postal_code String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  items          order_items[]
  payments       payments[]
}

// 18. Order Items (Snapshot table)
model order_items {
  id           String           @id @default(uuid())
  order_id     String
  order        orders           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant_id   String
  variant      product_variants @relation(fields: [variant_id], references: [id])
  product_name String
  variant_name String
  sku          String
  price        Decimal          @db.Decimal(10, 2)
  quantity     Int
  discount     Decimal          @default(0) @db.Decimal(10, 2)
  subtotal     Decimal          @db.Decimal(10, 2)
}

// 19. Payments (Stripe)
model payments {
  id                      String         @id @default(uuid())
  order_id                String
  order                   orders         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  provider                String         @default("STRIPE")
  provider_payment_intent String?
  provider_charge_id      String?
  amount                  Decimal        @db.Decimal(10, 2)
  currency                String         @default("AED")
  status                  payment_status @default(PENDING)
  paid_at                 DateTime?
  response_json           Json?
  refunds                 refunds[]
}

// 20. Refunds
model refunds {
  id               String       @id @default(uuid())
  payment_id       String
  payment          payments     @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  amount           Decimal      @db.Decimal(10, 2)
  reason           String?
  stripe_refund_id String?
  status           refund_status @default(PENDING)
  created_at       DateTime     @default(now())
}

// 21. Reviews
model reviews {
  id          String       @id @default(uuid())
  product_id  String
  product     products     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer_id String
  customer    customers    @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  rating      Int
  review      String?
  status      review_status @default(PENDING)
  created_at  DateTime     @default(now())
}

// 22. Wishlist
model wishlists {
  customer_id String
  product_id  String
  customer    customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product     products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([customer_id, product_id])
}

// 23. Inventory Transactions (Audit Log)
model inventory_transactions {
  id             String                    @id @default(uuid())
  variant_id     String
  variant        product_variants          @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  warehouse_id   String
  warehouse      warehouses                @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  type           inventory_transaction_type
  quantity       Int
  reference_type String?
  reference_id   String?
  created_at     DateTime                  @default(now())
}

// 24. Homepage Banners (Admin-managed)
model banners {
  id         String   @id @default(uuid())
  title      String
  subtitle   String?
  cta_text   String?
  cta_link         String?
  image_url        String
  alt_text         String?
  size_type        String   @default("HERO") // HERO or SMALL
  size_description String?  // e.g. "Desktop: 1920x800px | Mobile: 800x800px" or "Small promo card: 600x400px"
  is_active        Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// 25. Site Settings (Key-Value store for SEO, branding)
model site_settings {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt
}

// 26. Offer Categories (Many-to-Many Join Table)
model offer_categories {
  offer_id    String
  category_id String
  offer       offers     @relation(fields: [offer_id], references: [id], onDelete: Cascade)
  category    categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([offer_id, category_id])
}

// 27. Product Related Categories (Many-to-Many Join Table)
model product_related_categories {
  product_id  String
  category_id String
  product     products   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  category    categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([product_id, category_id])
}

// 28. Real-time Customer & Session Support Chat
model chat_sessions {
  id                    String          @id @default(uuid())
  session_id            String          @unique
  customer_id           String?
  customer_name         String          @default("Guest Visitor")
  customer_email        String?
  ip_address            String?
  status                String          @default("ACTIVE") // ACTIVE, RESOLVED, CLOSED
  unread_admin_count    Int             @default(0)
  unread_customer_count Int             @default(0)
  is_customer_typing    Boolean         @default(false)
  is_admin_typing       Boolean         @default(false)
  last_message_at       DateTime        @default(now())
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  customer              customers?      @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  messages              chat_messages[]

  @@index([session_id])
  @@index([last_message_at])
}

model chat_messages {
  id              String        @id @default(uuid())
  session_id      String
  sender_type     String        // 'CUSTOMER' | 'ADMIN' | 'BOT'
  sender_name     String
  message         String?       @default("") @db.Text
  attachment_url  String?       @db.Text
  attachment_type String?       // 'image' | 'file'
  attachment_name String?
  is_read         Boolean       @default(false)
  created_at      DateTime      @default(now())

  session         chat_sessions @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@index([session_id])
  @@index([created_at])
}

// 29. Dynamic CMS Pages (WordPress / Elementor-style Drag and Drop Page Builder)
model pages {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  content          String?  @db.Text // JSON string containing ordered block array
  html_cache       String?  @db.Text
  meta_title       String?
  meta_description String?
  is_published     Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([slug])
  @@index([is_published])
}

// 30. High-Performance System & Request Logs (Winston + Database)
model system_logs {
  id          String   @id @default(uuid())
  level       String   @default("info") // 'info' | 'warn' | 'error'
  method      String   // 'GET' | 'POST' | 'PATCH' | 'DELETE'
  route       String   // Request path
  status_code Int      // HTTP status code
  duration_ms Float    // Response time in ms
  ip          String?
  query       String?  @db.Text // Query params
  payload     String?  @db.Text // Sanitized request body
  user_agent  String?  @db.Text
  error_stack String?  @db.Text
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([duration_ms])
  @@index([status_code])
  @@index([route])
  @@index([method])
}

// 31. Blog Posts & Articles
model blogs {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  excerpt        String?         @db.Text
  content        String          @db.Text
  featured_image String?         @db.Text
  category       String          @default("Abaya")
  author         String          @default("Saba Al Wadi")
  views          Int             @default(0)
  is_published   Boolean         @default(true)
  published_at   DateTime        @default(now())
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  comments       blog_comments[]

  @@index([slug])
  @@index([category])
  @@index([is_published])
  @@index([views])
  @@index([created_at])
}

// 32. Blog Comments & Moderation
model blog_comments {
  id           String   @id @default(uuid())
  blog_id      String
  blog         blogs    @relation(fields: [blog_id], references: [id], onDelete: Cascade)
  author_name  String
  author_email String
  content      String   @db.Text
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([blog_id])
  @@index([status])
  @@index([created_at])
}

// 33. Delivery Partners & Courier Services
model delivery_partners {
  id                    String    @id @default(uuid())
  name                  String    @unique
  tracking_url_template String?   // e.g. "https://www.aramex.com/track/results?shipmentNumber={tracking_number}"
  contact_phone         String?
  is_active             Boolean   @default(true)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([is_active])
}

